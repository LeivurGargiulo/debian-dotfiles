# i3 config file (v4)
# Orange Neon Glass

set $mod Mod4

# Colors Catppuccin
set $rosewater #ffcf9c
set $flamingo #ffb86c
set $pink #ff9500
set $mauve #ff6a00
set $red #f38ba8
set $maroon #cc2400
set $peach #ff9500
set $yellow #f9e2af
set $green #a6e3a1
set $teal #ff8c3d
set $sky #ffa057
set $sapphire #ff7a1a
set $blue #ffc266
set $lavender #ffd9a0
set $text #ffedd5
set $subtext1 #e0a465
set $subtext0 #c98b52
set $overlay2 #a8703f
set $overlay1 #8a5a3a
set $overlay0 #6b4a30
set $surface2 #3d2716
set $surface1 #2e1c0f
set $surface0 #1f120a
set $base #0d0704
set $mantle #0a0503
set $crust #060302

# Theming
# target                 border   bg      text   indicator  child_border
client.focused           $mauve   $base   $mauve $mauve     $mauve
client.focused_inactive  $base    $base   $mauve $base      $base
client.unfocused         $base    $mantle $text  $base      $base
client.urgent            $peach   $base   $peach $peach     $peach
client.background        $base

# Resolution
exec_always --no-startup-id xrandr --auto
exec_always --no-startup-id xsetroot -cursor_name left_ptr

# Border
default_border pixel 1
default_floating_border pixel 1

# Activate smart borders
smart_borders on

# Gaps
gaps inner 8
gaps outer 0

# Turn off bell
exec --no-startup-id xset b off

# Compositor
exec --no-startup-id picom --config ~/.config/picom/i3.conf -b
bindsym $mod+p exec --no-startup-id ~/.local/share/i3/scripts/toggle_picom.sh

# keyboard layout
exec --no-startup-id setxkbmap -layout us,latam -option grp:alt_shift_toggle

# Background
exec_always --no-startup-id nitrogen --restore

# Polybar
exec_always --no-startup-id ~/.config/polybar/launch.sh

# Tray applets (network, bluetooth, polkit) — polybar's tray module needs
# these actually running, upstream never execs them
exec --no-startup-id nm-applet &
exec --no-startup-id blueman-applet &
exec --no-startup-id /usr/bin/lxpolkit &

# Notifications
exec --no-startup-id dunst

# Lockscreen
bindsym $mod+x exec ~/.local/share/i3/scripts/lock.sh

# Clipboard
exec --no-startup-id greenclip daemon >/dev/null 2>&1
bindsym $mod+c exec --no-startup-id rofi -modi "clipboard:greenclip print" -show clipboard -run-command '{cmd}' -theme ~/.config/rofi/config.rasi

# dbus
exec --no-startup-id dbus-update-activation-environment --all

# Screenshot
bindsym $mod+Shift+s exec flameshot gui

# Font for window titles.
font pango:CaskaydiaCove Nerd Font Mono 11

# Start XDG autostart .desktop files using dex.
exec --no-startup-id dex --autostart --environment i3

exec --no-startup-id xset s off
exec --no-startup-id xset -dpms
exec --no-startup-id xset s noblank

# use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# start a terminal
bindsym $mod+Return exec kitty
bindsym $mod+t exec kitty

# kill focused window
bindsym $mod+q kill

# start rofi (a program launcher)
bindsym $mod+d exec --no-startup-id "rofi -show drun -show-icons"
bindsym --release Super_L exec --no-startup-id "rofi -show drun -show-icons"

# power menu
bindsym $mod+Shift+e exec --no-startup-id ~/.local/share/rofi/scripts/powermenu.sh

# change focus
bindsym $mod+j focus left
bindsym $mod+k focus down
bindsym $mod+l focus up
bindsym $mod+semicolon focus right

# alternatively, you can use the cursor keys
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# move focused window
bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+l move up
bindsym $mod+Shift+semicolon move right

# alternatively, you can use the cursor keys
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# split in horizontal orientation
bindsym $mod+h split h

# split in vertical orientation
bindsym $mod+v split v

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# change container layout (stacked, tabbed, toggle split)
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# resize tiles directly, no mode needed
bindsym Mod1+Left resize shrink width 10 px or 10 ppt
bindsym Mod1+Right resize grow width 10 px or 10 ppt
bindsym Mod1+Up resize shrink height 10 px or 10 ppt
bindsym Mod1+Down resize grow height 10 px or 10 ppt

# start rofi (a program launcher)
bindsym $mod+space exec --no-startup-id "rofi -show drun -show-icons"

# focus the parent container
bindsym $mod+a focus parent

# focus the child container
#bindsym $mod+d focus child

# move the currently focused window to the scratchpad
bindsym $mod+Shift+minus move scratchpad

# Show the next scratchpad window or hide the focused scratchpad window.
bindsym $mod+minus scratchpad show

# Define names for default workspaces
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# switch between tiled windows
bindsym $mod+Tab exec --no-startup-id "rofi -show window"
bindsym $mod+Shift+Tab workspace prev

# switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# reload the configuration file
bindsym $mod+Shift+c reload
# restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym $mod+Shift+r restart
# exit i3 (logs you out of your X session)
bindsym $mod+Shift+x exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"

# resize window (you can also use the mouse for that)
mode "resize" {
        bindsym j resize shrink width 10 px or 10 ppt
        bindsym k resize grow height 10 px or 10 ppt
        bindsym l resize shrink height 10 px or 10 ppt
        bindsym semicolon resize grow width 10 px or 10 ppt

        # same bindings, but for the arrow keys
        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        # back to normal: Enter or Escape or $mod+r
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"

# volume/brightness keys
set $refresh_i3status killall -SIGUSR1 i3status
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10% && $refresh_i3status
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10% && $refresh_i3status
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status
bindsym XF86MonBrightnessUp exec --no-startup-id light -A 10
bindsym XF86MonBrightnessDown exec --no-startup-id light -U 10
