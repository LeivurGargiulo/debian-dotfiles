# ~/.config/betterlockscreenrc — Catppuccin Mocha Mauve

display_on=0
span_image=false
lock_timeout=300
fx_list=(dim)
dim_level=40
wallpaper_cmd="feh --bg-fill"
quiet=false

locktext="Type Password..."
font="CaskaydiaCove Nerd Font"
time_format="%H:%M:%S"

# colorice — once you run `colorice <wallpaper> --apply`, this file exists
[ -f ~/.config/betterlockscreen/colorice-colors.sh ] && source ~/.config/betterlockscreen/colorice-colors.sh
