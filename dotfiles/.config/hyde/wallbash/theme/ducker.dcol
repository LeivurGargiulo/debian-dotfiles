${HOME}/.config/ducker/config.yaml
# Generated by wallbash from the active HyDE theme — do not edit directly,
# edit dotfiles/.config/hyde/wallbash/theme/ducker.dcol instead.
# Color fields deserialize plain #RRGGBB hex; use_theme: true is required
# or ducker falls back to its hardcoded palette.
theme:
  use_theme: true
  title: "#<wallbash_2xa7>"
  help: "#<wallbash_3xa7>"
  background: "#<wallbash_pry1>"
  footer: "#<wallbash_3xa7>"
  success: "#<wallbash_2xa9>"
  error: "#<wallbash_4xa9>"
  positive_highlight: "#<wallbash_2xa9>"
  negative_highlight: "#<wallbash_4xa9>"
