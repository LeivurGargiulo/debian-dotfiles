${HOME}/.config/nvim/lua/custom/wallbash-colors.lua
-- Generated by wallbash from the active HyDE theme — do not edit directly,
-- edit dotfiles/.config/hyde/wallbash/theme/nvim.dcol instead. Loaded by
-- dotfiles/.config/nvim/lua/custom/config/wallbash-theme.lua.
local bg = '#<wallbash_pry1>'
local bg_dark = '#<wallbash_pry2>'
local bg_alt = '#<wallbash_pry3>'
local fg = '#<wallbash_txt1>'
local muted = '#<wallbash_1xa9>'
local red = '#<wallbash_4xa9>'
local orange = '#<wallbash_1xa7>'
local yellow = '#<wallbash_3xa9>'
local green = '#<wallbash_2xa9>'
local cyan = '#<wallbash_3xa7>'
local purple = '#<wallbash_2xa7>'

vim.cmd 'hi clear'
if vim.fn.exists 'syntax_on' then
  vim.cmd 'syntax reset'
end
vim.o.background = 'dark'
vim.g.colors_name = 'wallbash'

local hl = vim.api.nvim_set_hl
local groups = {
  Normal = { fg = fg, bg = bg },
  NormalFloat = { fg = fg, bg = bg_dark },
  Comment = { fg = muted, italic = true },
  Constant = { fg = purple },
  String = { fg = yellow },
  Character = { fg = yellow },
  Number = { fg = purple },
  Boolean = { fg = purple },
  Float = { fg = purple },
  Identifier = { fg = fg },
  Function = { fg = green },
  Statement = { fg = red },
  Conditional = { fg = red },
  Repeat = { fg = red },
  Label = { fg = red },
  Operator = { fg = red },
  Keyword = { fg = red },
  Exception = { fg = red },
  PreProc = { fg = cyan },
  Include = { fg = cyan },
  Define = { fg = cyan },
  Macro = { fg = cyan },
  PreCondit = { fg = cyan },
  Type = { fg = cyan },
  StorageClass = { fg = cyan },
  Structure = { fg = cyan },
  Typedef = { fg = cyan },
  Special = { fg = orange },
  SpecialChar = { fg = orange },
  Tag = { fg = red },
  Delimiter = { fg = fg },
  SpecialComment = { fg = muted, italic = true },
  Debug = { fg = orange },
  Underlined = { underline = true },
  Ignore = { fg = muted },
  Error = { fg = bg, bg = red },
  Todo = { fg = bg, bg = yellow, bold = true },
  LineNr = { fg = muted },
  CursorLineNr = { fg = yellow },
  CursorLine = { bg = bg_dark },
  Visual = { bg = bg_alt },
  Search = { fg = bg, bg = yellow },
  IncSearch = { fg = bg, bg = orange },
  Pmenu = { fg = fg, bg = bg_dark },
  PmenuSel = { fg = bg, bg = purple },
  StatusLine = { fg = fg, bg = bg_dark },
  StatusLineNC = { fg = muted, bg = bg_dark },
  VertSplit = { fg = bg_dark },
  WinSeparator = { fg = bg_dark },
  SignColumn = { bg = bg },
  FoldColumn = { fg = muted, bg = bg },
  Folded = { fg = muted, bg = bg_dark },
  MatchParen = { fg = bg, bg = orange, bold = true },
  DiffAdd = { fg = green, bg = bg_dark },
  DiffChange = { fg = yellow, bg = bg_dark },
  DiffDelete = { fg = red, bg = bg_dark },
  DiffText = { fg = cyan, bg = bg_dark, bold = true },
  DiagnosticError = { fg = red },
  DiagnosticWarn = { fg = yellow },
  DiagnosticInfo = { fg = cyan },
  DiagnosticHint = { fg = purple },
}
for group, opts in pairs(groups) do
  hl(0, group, opts)
end
