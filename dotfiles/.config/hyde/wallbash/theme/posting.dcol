${HOME}/.local/share/posting/themes/wallbash.yaml
# Generated by wallbash from the active HyDE theme — do not edit directly,
# edit dotfiles/.config/hyde/wallbash/theme/posting.dcol instead.
name: wallbash
primary: '#<wallbash_2xa7>'
secondary: '#<wallbash_3xa7>'
accent: '#<wallbash_4xa9>'
background: '#<wallbash_pry1>'
surface: '#<wallbash_pry2>'
panel: '#<wallbash_pry2>'
error: '#<wallbash_4xa9>'
success: '#<wallbash_2xa9>'
warning: '#<wallbash_3xa9>'
text: '#<wallbash_txt1>'
dark: true

text_area:
  gutter: '#<wallbash_1xa9> on #<wallbash_pry2>'
  cursor: 'reverse'
  cursor_line: 'on #<wallbash_pry2>'
  cursor_line_gutter: '#<wallbash_txt1> on #<wallbash_pry3>'
  matched_bracket: 'underline #<wallbash_3xa9>'
  selection: 'on #<wallbash_pry3>'

syntax:
  json_key: '#<wallbash_2xa7>'
  json_string: '#<wallbash_3xa9>'
  json_number: '#<wallbash_2xa7>'
  json_boolean: '#<wallbash_4xa9>'
  json_null: '#<wallbash_1xa9>'

url:
  base: '#<wallbash_3xa7>'
  protocol: 'bold #<wallbash_2xa7>'
  separator: 'dim #<wallbash_1xa9>'

variable:
  resolved: '#<wallbash_pry1> on #<wallbash_2xa9>'
  unresolved: '#<wallbash_pry1> on #<wallbash_4xa9>'
