ZSH_HIGHLIGHT_STYLES[alias]='fg=#<wallbash_2xa9>'
ZSH_HIGHLIGHT_STYLES[builtin]='fg=#<wallbash_2xa9>'
ZSH_HIGHLIGHT_STYLES[function]='fg=#<wallbash_2xa9>'
ZSH_HIGHLIGHT_STYLES[command]='fg=#<wallbash_2xa9>'
ZSH_HIGHLIGHT_STYLES[precommand]='fg=#<wallbash_2xa9>,italic'
ZSH_HIGHLIGHT_STYLES[commandseparator]='fg=#<wallbash_1xa9>'
ZSH_HIGHLIGHT_STYLES[hashed-command]='fg=#<wallbash_2xa9>'
ZSH_HIGHLIGHT_STYLES[path]='fg=#<wallbash_3xa7>'
ZSH_HIGHLIGHT_STYLES[path_pathseparator]='fg=#<wallbash_1xa9>'
ZSH_HIGHLIGHT_STYLES[globbing]='fg=#<wallbash_2xa7>'
