${HOME}/.config/zsh/wallbash-colors.zsh
# Generated by wallbash — do not edit directly, edit
# dotfiles/.config/hyde/wallbash/theme/zsh-colors.dcol instead.

export FZF_DEFAULT_OPTS="--color=fg:#<wallbash_txt1>,bg:#<wallbash_pry1>,hl:#<wallbash_4xa9>,fg+:#<wallbash_txt1>,bg+:#<wallbash_pry2>,hl+:#<wallbash_1xa7>,info:#<wallbash_2xa7>,prompt:#<wallbash_3xa7>,pointer:#<wallbash_4xa9>,marker:#<wallbash_2xa9>,spinner:#<wallbash_3xa9>,header:#<wallbash_1xa9>,border:#<wallbash_1xa9>,gutter:#<wallbash_pry1>,query:#<wallbash_txt1>"

typeset -A ZSH_HIGHLIGHT_STYLES
ZSH_HIGHLIGHT_STYLES[default]='fg=#<wallbash_txt1>'
ZSH_HIGHLIGHT_STYLES[unknown-token]='fg=#<wallbash_4xa9>'
