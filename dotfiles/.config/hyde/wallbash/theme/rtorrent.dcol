${HOME}/.config/rtorrent/rtorrent.rc
# Generated by wallbash from the active HyDE theme — do not edit directly,
# edit dotfiles/.config/hyde/wallbash/theme/rtorrent.dcol instead.
# rtorrent's stock color-scheme support is limited (the rtorrent-ps patch
# adds real per-element theming); if the installed rtorrent lacks
# rtorrent-ps, most of these keys are silently ignored — verify `rtorrent
# -h` mentions "rtorrent-ps" before relying on this file.
method.set_key = main, color.title, "#<wallbash_2xa7>"
method.set_key = main, color.background, "#<wallbash_pry1>"
method.set_key = main, color.text, "#<wallbash_txt1>"
method.set_key = main, color.progress, "#<wallbash_2xa9>"
method.set_key = main, color.alarm, "#<wallbash_4xa9>"
