${HOME}/.config/gh-dash/config.yml
# Generated by wallbash from the active HyDE theme — do not edit directly,
# edit dotfiles/.config/hyde/wallbash/theme/gh-dash.dcol instead.
theme:
  ui:
    table:
      sectionsShowCount: true
      showSeparators: true
      compact: false
  colors:
    text:
      primary: "#<wallbash_txt1>"
      secondary: "#<wallbash_1xa9>"
      inverted: "#<wallbash_pry1>"
      faint: "#<wallbash_1xa9>"
      warning: "#<wallbash_3xa9>"
      success: "#<wallbash_2xa9>"
    background:
      selected: "#<wallbash_pry3>"
    border:
      primary: "#<wallbash_2xa7>"
      secondary: "#<wallbash_1xa9>"
      faint: "#<wallbash_pry2>"
