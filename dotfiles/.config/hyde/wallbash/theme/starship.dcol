${HOME}/.config/starship.toml
# Generated by wallbash from the active HyDE theme — do not edit directly,
# edit dotfiles/.config/hyde/wallbash/theme/starship.dcol instead.
# Two-line layout (directory/git/status on line 1, prompt character on
# line 2). Multi-line `format` + add_newline=false verified against
# starship.rs/config/.
add_newline = false

format = """
[](fg:#<wallbash_pry2>)$os$username[](bg:#<wallbash_pry2> fg:#<wallbash_2xa7>)$directory[](fg:#<wallbash_pry2> bg:#<wallbash_2xa7>)$git_branch$git_status[](fg:#<wallbash_pry2>) $cmd_duration$time
$character"""

palette = "wallbash"

[palettes.wallbash]
bg = "#<wallbash_pry1>"
bg_dark = "#<wallbash_pry2>"
fg = "#<wallbash_txt1>"
dim = "#<wallbash_1xa9>"
pink = "#<wallbash_4xa9>"
orange = "#<wallbash_1xa7>"
yellow = "#<wallbash_3xa9>"
green = "#<wallbash_2xa9>"
cyan = "#<wallbash_3xa7>"
purple = "#<wallbash_2xa7>"

[os]
disabled = false
style = "bg:#<wallbash_pry2> fg:#<wallbash_3xa7>"

[os.symbols]
Arch = "󰣇 "

[username]
style_user = "bg:#<wallbash_pry2> fg:#<wallbash_txt1>"
style_root = "bg:#<wallbash_pry2> fg:#<wallbash_4xa9>"
format = "[$user]($style)"
disabled = false
show_always = false

[directory]
style = "bg:#<wallbash_pry2> fg:#<wallbash_2xa7>"
format = "[ $path ]($style)"
truncation_length = 3
truncate_to_repo = true

[git_branch]
style = "bg:#<wallbash_2xa7> fg:#<wallbash_pry1>"
format = "[ $symbol$branch ]($style)"
symbol = " "

[git_status]
style = "bg:#<wallbash_2xa7> fg:#<wallbash_pry1>"
format = "[$all_status$ahead_behind ]($style)"
conflicted = "="
ahead = "⇡${count}"
behind = "⇣${count}"
diverged = "⇕⇡${ahead_count}⇣${behind_count}"
untracked = "?${count}"
stashed = "\\$${count}"
modified = "!${count}"
staged = "+${count}"
renamed = "»${count}"
deleted = "✘${count}"

[character]
success_symbol = "[➜](bold #<wallbash_2xa9>)"
error_symbol = "[➜](bold #<wallbash_4xa9>)"
vimcmd_symbol = "[❮](bold #<wallbash_3xa7>)"

[cmd_duration]
style = "fg:#<wallbash_3xa9>"
format = "took [$duration]($style) "
min_time = 2000

[time]
disabled = false
style = "fg:#<wallbash_1xa9>"
format = "[$time]($style)"
time_format = "%R"
