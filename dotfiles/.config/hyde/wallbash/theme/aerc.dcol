${HOME}/.config/aerc/stylesets/wallbash
# vim: ft=dosini
*.default=true
*.normal=true

title.bg=#<wallbash_pry1>
title.fg=#<wallbash_txt1>
title.bold=true

header.bold=true
header.fg=#<wallbash_2xa7>

border.fg=#<wallbash_1xa9>
border.bg=#<wallbash_pry1>

tab.selected.fg=#<wallbash_pry1>
tab.selected.bg=#<wallbash_2xa7>
tab.selected.bold=false

*error.bold=true
*error.fg=#<wallbash_4xa9>
*warning.fg=#<wallbash_3xa9>
*success.fg=#<wallbash_2xa9>

statusline_default.bg=#<wallbash_pry2>
statusline_default.fg=#<wallbash_txt1>
statusline_error.fg=#<wallbash_4xa9>

msglist_unread.fg=#<wallbash_txt1>
msglist_unread.bold=true
msglist_deleted.fg=#<wallbash_1xa9>
msglist_*.selected.bg=#<wallbash_pry2>
msglist_result.bg=#<wallbash_3xa7>
msglist_marked.fg=#<wallbash_pry1>
msglist_marked.bg=#<wallbash_1xa7>

selector_focused.bg=#<wallbash_pry2>
selector_focused.fg=#<wallbash_txt1>
selector_chooser.bg=#<wallbash_pry2>
selector_chooser.fg=#<wallbash_txt1>
default.selected.fg=#<wallbash_txt1>
default.selected.bg=#<wallbash_pry2>

completion_default.selected.bg=#<wallbash_pry2>
completion_default.selected.fg=#<wallbash_txt1>

[viewer]
*.default=true
*.normal=true
url.underline=true
header.bold=true
signature.dim=true
diff_add.fg=#<wallbash_2xa9>
diff_del.fg=#<wallbash_4xa9>
diff_whitespace.bg=#<wallbash_4xa9>
quote_*.fg=#<wallbash_3xa7>
code.fg=#<wallbash_2xa7>
