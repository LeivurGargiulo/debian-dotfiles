# theme.dcol -- Monokai Pro palette override, sourced by HyDE's wallbash
# color.set.sh AFTER the wallpaper-derived dcol (`source "$dcol_file"`), so
# these values win regardless of the active wallpaper. Canonical hex table:
# docs/monokai-pro-palette.md. Role map (established by HyDE's own stock
# wallbash templates -- kitty.dcol/waybar.dcol/rofi.dcol/dunst.dcol -- and by
# this repo's own dotfiles/.config/hyde/wallbash/theme/*.dcol):
#   pry1/txt1 = background / foreground
#   pry2      = background-darker (panel/status/selection surfaces)
#   pry3      = selection/highlight surface
#   pry4/txt4 = pink/red vivid accent, with readable dark text on it
#   1xaN      = neutral gray ramp (ends at the canonical dimmed gray),
#               except 1xa7 = orange, standing in for kitty's ANSI "blue"
#               slot (Monokai Pro has no true blue -- same substitution
#               dotfiles/.config/hyde/themes/Monokai-Pro/kitty.theme uses)
#   2xaN      = green ramp, except 2xa7 = purple (kitty's magenta slot)
#   3xaN      = yellow ramp, except 3xa7 = cyan (kitty's cyan slot)
#   4xaN      = pink/red ramp (no off-family landmark needed here)
dcol_mode=dark

dcol_pry1=2d2a2e
dcol_txt1=fcfcfa
dcol_1xa1=201d20
dcol_1xa2=2a262a
dcol_1xa3=343034
dcol_1xa4=3e393e
dcol_1xa5=484247
dcol_1xa6=524b51
dcol_1xa7=fc9867
dcol_1xa8=847d8c
dcol_1xa9=939293

dcol_pry2=221f22
dcol_txt2=fcfcfa
dcol_2xa1=1c231d
dcol_2xa2=26332a
dcol_2xa3=304333
dcol_2xa4=3a533c
dcol_2xa5=44634a
dcol_2xa6=548a5c
dcol_2xa7=ab9df2
dcol_2xa8=8ecb6a
dcol_2xa9=a9dc76

dcol_pry3=403e41
dcol_txt3=fcfcfa
dcol_3xa1=241f1a
dcol_3xa2=332c22
dcol_3xa3=42392b
dcol_3xa4=514634
dcol_3xa5=60533d
dcol_3xa6=8a6f4a
dcol_3xa7=78dce8
dcol_3xa8=ffcf66
dcol_3xa9=ffd866

dcol_pry4=ff6188
dcol_txt4=2d2a2e
dcol_4xa1=2d2a2e
dcol_4xa2=3d232b
dcol_4xa3=4d2c34
dcol_4xa4=5d353d
