# rgba variants -- \1 is a literal sed backreference: wallbash's
# create_wallbash_substitutions() captures whatever alpha a template asks
# for via <wallbash_pryN_rgba(0.XX)> and splices it in via this \1, so the
# requested alpha is honored no matter what's written here for R,G,B.
dcol_pry1_rgba="rgba(45,42,46,\1)"
dcol_txt1_rgba="rgba(252,252,250,\1)"
dcol_1xa1_rgba="rgba(32,29,32,\1)"
dcol_1xa2_rgba="rgba(42,38,42,\1)"
