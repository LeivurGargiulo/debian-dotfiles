$HOME/.config/hypr/themes/theme.conf|> $HOME/.config/hypr/themes/colors.conf
# Monokai Pro
# Palette source: docs/monokai-pro-palette.md

$HYDE_THEME = Monokai Pro
$GTK_THEME = Wallbash-Gtk
$ICON_THEME = Papirus
$COLOR_SCHEME = prefer-dark
$CURSOR_THEME = Bibata-Monokai
$CURSOR_SIZE = 24
$FONT = Ubuntu Sans
$FONT_SIZE = 10
$MONOSPACE_FONT = FiraCode Nerd Font Mono
$MONOSPACE_FONT_SIZE = 9
$CODE_THEME = Wallbash
$SDDM_THEME =

exec = gsettings set org.gnome.desktop.interface icon-theme $ICON_THEME
exec = gsettings set org.gnome.desktop.interface gtk-theme $GTK_THEME
exec = gsettings set org.gnome.desktop.interface color-scheme $COLOR_SCHEME

general {
    gaps_in = 3
    gaps_out = 8
    border_size = 2
    col.active_border = rgba(ff6188e6) rgba(ab9df2e6) 45deg
    col.inactive_border = rgba(403e4199) rgba(2d2a2e99) 45deg
    layout = dwindle
    resize_on_border = true
}

group {
    col.border_active = rgba(ff6188e6) rgba(ab9df2e6) 45deg
    col.border_inactive = rgba(403e4199) rgba(2d2a2e99) 45deg
    col.border_locked_active = rgba(ff6188e6) rgba(ab9df2e6) 45deg
    col.border_locked_inactive = rgba(403e4199) rgba(2d2a2e99) 45deg
}

decoration {
    rounding = 10
    active_opacity = 0.75
    inactive_opacity = 0.75
    fullscreen_opacity = 1.0

    shadow {
        enabled = yes
        ignore_window = true
        offset = 0 0
        range = 15
        render_power = 1
        color = 0x80000000
    }

    blur {
        enabled = yes
        size = 8
        passes = 4
        new_optimizations = on
        ignore_opacity = on
        xray = false
    }
}

layerrule = blur,waybar
layerrule = blur,rofi
layerrule = ignorezero,rofi
