$HOME/.config/kitty/theme.conf|killall -SIGUSR1 kitty
## name: Monokai Pro
## license: MIT
## upstream: docs/monokai-pro-palette.md (this repo's canonical palette)
## blurb: The 2018-rebrand Monokai Pro palette — warm dark background, punchy pink/orange/yellow/green/cyan/purple accents

foreground               #fcfcfa
background               #2d2a2e
background_opacity       0.75
dynamic_background_opacity yes
selection_foreground     #fcfcfa
selection_background     #403e41

cursor                   #fcfcfa
cursor_text_color        #2d2a2e

url_color                #ffd866

active_tab_foreground    #2d2a2e
active_tab_background    #ff6188
inactive_tab_foreground  #939293
inactive_tab_background  #221f22

active_border_color      #ff6188
inactive_border_color    #403e41

# black
color0   #221f22
color8   #727072

# red
color1   #ff6188
color9   #ff6188

# green
color2   #a9dc76
color10  #a9dc76

# yellow
color3   #ffd866
color11  #ffd866

# blue (Monokai Pro has no true blue — orange fills the slot, same as its official terminal profiles)
color4   #fc9867
color12  #fc9867

# magenta
color5   #ab9df2
color13  #ab9df2

# cyan
color6   #78dce8
color14  #78dce8

# white
color7   #fcfcfa
color15  #fcfcfa
