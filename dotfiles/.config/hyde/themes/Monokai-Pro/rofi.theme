$HOME/.config/rofi/theme.rasi
/* Monokai Pro — palette source: docs/monokai-pro-palette.md */
* {
    main-bg:            #2d2a2ebf;
    main-fg:            #fcfcfaff;
    main-br:            #ab9df2ff;
    main-ex:            #78dce8bf;
    select-bg:          #ff6188ff;
    select-fg:          #2d2a2eff;
    separatorcolor:     transparent;
    border-color:       transparent;
}
