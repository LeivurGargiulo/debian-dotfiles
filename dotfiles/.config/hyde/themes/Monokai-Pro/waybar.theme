$HOME/.config/waybar/theme.css|${scrDir}/wbarconfgen.sh
/* Monokai Pro — palette source: docs/monokai-pro-palette.md */
/* To enable blur please make sure alpha is greater than 0 */
@define-color bar-bg rgba(0, 0, 0, 0.05);

@define-color main-bg #2d2a2e;
@define-color main-fg #ab9df2;

@define-color wb-act-bg #403e41;
@define-color wb-act-fg #78dce8;

@define-color wb-hvr-bg #ff6188;
@define-color wb-hvr-fg #ffd866;
