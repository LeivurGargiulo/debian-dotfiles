{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "arch",
    "color": { "1": "white" },
    "padding": { "top": 2, "left": 2, "right": 2 }
  },
  "display": {
    "separator": " \u001b[38;2;120;220;232m◆\u001b[0m ",
    "constants": [
      "\u001b[38;2;255;97;136m─────────────────\u001b[0m"
    ],
    "key": { "type": "icon", "paddingLeft": 2 }
  },
  "modules": [
    "title",
    "separator",
    { "type": "custom", "format": "\u001b[38;2;255;97;136m┌\u001b[0m{$1} \u001b[38;2;120;220;232mHardware Information\u001b[0m {$1}\u001b[38;2;255;97;136m┐\u001b[0m" },
    { "type": "host", "keyColor": "171;157;242" },
    { "type": "cpu", "keyColor": "171;157;242" },
    { "type": "gpu", "keyColor": "171;157;242" },
    { "type": "disk", "keyColor": "171;157;242" },
    { "type": "memory", "keyColor": "171;157;242" },
    { "type": "display", "keyColor": "171;157;242", "format": "{width}x{height} in 27\", {refresh-rate} Hz [{type}]" },
    { "type": "custom", "format": "\u001b[38;2;255;97;136m└\u001b[0m{$1}\u001b[38;2;255;97;136m──────────────────\u001b[0m{$1}\u001b[38;2;255;97;136m┘\u001b[0m" },
    { "type": "custom", "format": "" },
    { "type": "custom", "format": "\u001b[38;2;255;97;136m┌\u001b[0m{$1} \u001b[38;2;120;220;232mSoftware Information\u001b[0m {$1}\u001b[38;2;255;97;136m┐\u001b[0m" },
    { "type": "os", "keyColor": "171;157;242" },
    { "type": "kernel", "keyColor": "171;157;242" },
    { "type": "lm", "keyColor": "171;157;242" },
    { "type": "wm", "keyColor": "171;157;242" },
    { "type": "shell", "keyColor": "171;157;242" },
    { "type": "terminal", "keyColor": "171;157;242" },
    { "type": "font", "keyColor": "171;157;242" },
    { "type": "icons", "keyColor": "171;157;242" },
    { "type": "packages", "keyColor": "171;157;242" },
    { "type": "uptime", "keyColor": "171;157;242" },
    { "type": "locale", "keyColor": "171;157;242" },
    { "type": "custom", "format": "\u001b[38;2;255;97;136m└\u001b[0m{$1}\u001b[38;2;255;97;136m──────────────────\u001b[0m{$1}\u001b[38;2;255;97;136m┘\u001b[0m" },
    { "type": "colors" }
  ]
}
