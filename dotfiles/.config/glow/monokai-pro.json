{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#fcfcfa",
    "margin": 2
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ "
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#ab9df2",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "#ab9df2",
    "background_color": "#221f22",
    "bold": true
  },
  "h2": {
    "prefix": "## "
  },
  "h3": {
    "prefix": "### "
  },
  "h4": {
    "prefix": "#### "
  },
  "h5": {
    "prefix": "##### "
  },
  "h6": {
    "prefix": "###### ",
    "color": "#78dce8",
    "bold": false
  },
  "text": {},
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true
  },
  "strong": {
    "bold": true
  },
  "hr": {
    "color": "#939293",
    "format": "\n--------\n"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#78dce8",
    "underline": true
  },
  "link_text": {
    "color": "#78dce8",
    "bold": true
  },
  "image": {
    "color": "#ab9df2",
    "underline": true
  },
  "image_text": {
    "color": "#939293",
    "format": "Image: {{.text}} →"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#ff6188",
    "background_color": "#221f22"
  },
  "code_block": {
    "color": "#939293",
    "margin": 2,
    "chroma": {
      "text": {
        "color": "#fcfcfa"
      },
      "error": {
        "color": "#2d2a2e",
        "background_color": "#ff6188"
      },
      "comment": {
        "color": "#939293"
      },
      "comment_preproc": {
        "color": "#78dce8"
      },
      "keyword": {
        "color": "#78dce8"
      },
      "keyword_reserved": {
        "color": "#ab9df2"
      },
      "keyword_namespace": {
        "color": "#ab9df2"
      },
      "keyword_type": {
        "color": "#a9dc76"
      },
      "operator": {
        "color": "#ff6188"
      },
      "punctuation": {
        "color": "#ffd866"
      },
      "name": {
        "color": "#fcfcfa"
      },
      "name_builtin": {
        "color": "#ab9df2"
      },
      "name_tag": {
        "color": "#a9dc76"
      },
      "name_attribute": {
        "color": "#78dce8"
      },
      "name_class": {
        "color": "#2d2a2e",
        "underline": true,
        "bold": true
      },
      "name_constant": {},
      "name_decorator": {
        "color": "#ffd866"
      },
      "name_exception": {},
      "name_function": {
        "color": "#a9dc76"
      },
      "name_other": {},
      "literal": {},
      "literal_number": {
        "color": "#ffd866"
      },
      "literal_date": {},
      "literal_string": {
        "color": "#78dce8"
      },
      "literal_string_escape": {
        "color": "#a9dc76"
      },
      "generic_deleted": {
        "color": "#ff6188"
      },
      "generic_emph": {
        "italic": true
      },
      "generic_inserted": {
        "color": "#a9dc76"
      },
      "generic_strong": {
        "bold": true
      },
      "generic_subheading": {
        "color": "#939293"
      },
      "background": {
        "background_color": "#2d2a2e"
      }
    }
  },
  "table": {},
  "definition_list": {},
  "definition_term": {},
  "definition_description": {
    "block_prefix": "\n🠶 "
  },
  "html_block": {},
  "html_span": {}
}
