[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    dark = true
    syntax-theme = Wallbash
    line-numbers = true

[include]
    # minus/plus/line-number/file/hunk-header colors, regenerated by
    # wallbash from the active HyDE theme — see
    # dotfiles/.config/hyde/wallbash/theme/delta.dcol
    path = ~/.config/delta/theme.gitconfig
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[user]
	name = Leivur Gargiulo
	email = leivurgargiulo@gmail.com
