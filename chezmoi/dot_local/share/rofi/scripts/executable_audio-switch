#!/bin/bash
# rofi script-mode: list pactl sinks, switch default + move active streams.

if [[ -z "$1" ]]; then
    pactl list short sinks | while read -r idx name _; do
        desc=$(pactl list sinks | grep -A1 "Name: $name" | grep "Device Description" | cut -d: -f2- | sed 's/^ *//')
        echo "${idx} — ${desc:-$name}"
    done
    exit 0
fi

idx="${1%% *}"
name=$(pactl list short sinks | awk -v i="$idx" '$1 == i {print $2}')
[[ -z "$name" ]] && exit 0

pactl set-default-sink "$name"
pactl list short sink-inputs | while read -r stream_id _; do
    pactl move-sink-input "$stream_id" "$name"
done
notify-send -t 1500 "audio output" "switched to ${name}"
