/* colorice — generated from {wallpaper} */
/* Imported by config.rasi after its own * {} block (rasi cascades, so this
   overrides bg-col/mauve/fg-col/etc — colorice's native rofi-colors.rasi
   template uses different property names this config doesn't reference). */
* {
    bg-col:       {background};
    bg-col-light: {background};
    border-col:   {background};
    selected-col: {background};
    mauve:        {color5.saturate_15};
    fg-col:       {foreground};
    fg-col2:      {color1};
    grey:         {color8};
}
