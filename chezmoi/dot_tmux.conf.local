# oh-my-tmux customisation file. Everything here is applied on top of
# ~/.tmux.conf, which sources this file and must not be edited directly.

# oh-my-tmux draws its own status bar; hand that job to Catppuccin instead.
tmux_conf_theme=disabled

set -g @catppuccin_flavor "mocha"
set -g @catppuccin_window_status_style "rounded"

run-shell ~/.config/tmux/plugins/catppuccin/catppuccin.tmux

set -g status-left-length 100
set -g status-right-length 100
set -g status-left ""
set -g status-right "#{E:@catppuccin_status_host}"
set -ag status-right "#{E:@catppuccin_status_session}"
set -ag status-right "#{E:@catppuccin_status_date_time}"
